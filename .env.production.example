# ==========================================
# PromoHub SaaS — Production Environment Variables
# ==========================================

# 1. Database (Supabase PostgreSQL + Transaction Connection Pooler)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.your_supabase_ref:your_password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection URL (Used for Drizzle migrations on port 5432)
DIRECT_URL="postgresql://postgres.your_supabase_ref:your_password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# 2. Redis Cache & Queue (Oracle VPS Docker or Upstash Redis)
# Internal VPS docker network: redis://redis:6379
# Remote Upstash URL: rediss://default:your_token@your_redis.upstash.io:6379
REDIS_URL="redis://redis:6379"

# 3. Security & AES-256 Encryption Secret (Must be exactly 32 hex bytes / chars)
# Generate using: openssl rand -hex 16
ENCRYPTION_SECRET="0123456789abcdef0123456789abcdef"

# 4. Web Application URLs (Vercel Frontend)
NEXT_PUBLIC_APP_URL="https://promohub.vercel.app"

# 5. External Integrations (Optional / Provider Specific)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyZ"
AI_API_KEY="sk-proj-your-ai-api-key"
